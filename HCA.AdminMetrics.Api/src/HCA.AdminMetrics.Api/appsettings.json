{
  "DbConnectionStr": "Set in Secrets",
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AWS": {
    "Region": "us-west-2"
  },
  "SecurityOptions": {
    "AdminGroupName": "U-S-HCA HHSCoalitionMPI-Prod FC"
  },
  "AdminMetrics": {
    "LookbackMinutes": 60,
    "PeriodSeconds": 300,
    "AllowedTenants": [
      "HHS Coalition",
      "Non-Coalition"
    ],
    "Metrics": {
      "AvgLatency": {
        "Namespace": "AWS/ApiGateway",
        "MetricName": "Latency",
        "Statistic": "Average",
        "Dimensions": {
          "ApiName": "HHSCoalitionMPI-Prod",
          "Stage": "prod"
        }
      },
      "P95Latency": {
        "Namespace": "AWS/ApiGateway",
        "MetricName": "Latency",
        "Statistic": "p95",
        "Dimensions": {
          "ApiName": "HHSCoalitionMPI-Prod",
          "Stage": "prod"
        }
      },
      "RequestCount": {
        "Namespace": "AWS/ApiGateway",
        "MetricName": "Count",
        "Statistic": "Sum",
        "NormalizeToPerMinute": true,
        "Dimensions": {
          "ApiName": "HHSCoalitionMPI-Prod",
          "Stage": "prod"
        }
      },
      "Error4xx": {
        "Namespace": "AWS/ApiGateway",
        "MetricName": "4XXError",
        "Statistic": "Sum",
        "Dimensions": {
          "ApiName": "HHSCoalitionMPI-Prod",
          "Stage": "prod"
        }
      },
      "Error5xx": {
        "Namespace": "AWS/ApiGateway",
        "MetricName": "5XXError",
        "Statistic": "Sum",
        "Dimensions": {
          "ApiName": "HHSCoalitionMPI-Prod",
          "Stage": "prod"
        }
      },
      "Concurrency": {
        "Namespace": "AWS/Lambda",
        "MetricName": "ConcurrentExecutions",
        "Statistic": "Maximum",
        "Dimensions": {
          "FunctionName": "mpi-frontend-api-lambda"
        }
      },
      "TimeoutCount": {
        "Namespace": "MPI/Operational",
        "MetricName": "TimeoutCount",
        "Statistic": "Sum",
        "Dimensions": {
          "Service": "MPI"
        }
      },
      "DependencyLatency": {
        "Namespace": "MPI/Operational",
        "MetricName": "DependencyLatency",
        "Statistic": "Average",
        "Dimensions": {
          "Dependency": "Verato"
        }
      }
    },
    "Thresholds": {
      "WarningLatencyMs": 500,
      "CriticalLatencyMs": 1000,
      "WarningErrorRatePercent": 1.0,
      "CriticalErrorRatePercent": 3.0,
      "WarningTimeoutCount": 1,
      "CriticalTimeoutCount": 5,
      "WarningConcurrency": 50,
      "CriticalConcurrency": 80
    },
    "CustomErrorLogs": {
      "PollIntervalMilliseconds": 1000,
      "QueryTimeoutSeconds": 20,
      "Limit": 50,
      "LogGroupName": "/aws/lambda/mpi-frontend-api-lambda",
      "QueryString": "fields @timestamp, @message, @log, Name as Name, Layer as Layer, ExceptionCustomProperties.FunctionName as FunctionName, ExceptionCustomProperties.ErrorCode as ErrorCode, ExceptionCustomProperties.ErrorMessage as Message, TrackingId, @logStream | filter @message like \"HCA-MPI-\" | sort @timestamp desc"
    },
    "UsageMetrics": {
      "LookbackHours": 24,
      "PollIntervalMilliseconds": 1000,
      "QueryTimeoutSeconds": 20,
      "Limit": 200,
      "LogGroupName": "api-gw-HHSCoalitionMPI-Prod-access",
      "QueryString": "fields @timestamp, ip, httpMethod, resourcePath, status, clientCertSubj, requestId | parse clientCertSubj /CN=(?<rawSystem>[^,]+)/ | stats count() as callCount, sum(status >= 400) as failedCount, sum(status < 400) as successCount, min(@timestamp) as firstSeen, max(@timestamp) as lastSeen by rawSystem, ip | sort callCount desc"
    }
  }
}
