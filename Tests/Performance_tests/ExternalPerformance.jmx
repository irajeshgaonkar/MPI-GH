<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Test Plan">
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
    </TestPlan>
    <hashTree>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="Server" elementType="Argument">
            <stringProp name="Argument.name">Server</stringProp>
            <stringProp name="Argument.value">${__P(Server,hhscoalitionmpi-api-dev.hca.wa.gov)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="Post" elementType="Argument">
            <stringProp name="Argument.name">Post</stringProp>
            <stringProp name="Argument.value">api/v1/postIdentity</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="DemographicQuery" elementType="Argument">
            <stringProp name="Argument.name">DemographicQuery</stringProp>
            <stringProp name="Argument.value">api/v1/demographicsQuery</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="DemographicSearch" elementType="Argument">
            <stringProp name="Argument.name">DemographicSearch</stringProp>
            <stringProp name="Argument.value">api/v1/demographicsSearch</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="Link" elementType="Argument">
            <stringProp name="Argument.name">Link</stringProp>
            <stringProp name="Argument.value">api/v1/linkIdentities</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="Unlink" elementType="Argument">
            <stringProp name="Argument.name">Unlink</stringProp>
            <stringProp name="Argument.value">api/v1/unlinkIdentities</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="Merge" elementType="Argument">
            <stringProp name="Argument.name">Merge</stringProp>
            <stringProp name="Argument.value">api/v1/mergeIdentities</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="Unmerge" elementType="Argument">
            <stringProp name="Argument.name">Unmerge</stringProp>
            <stringProp name="Argument.value">api/v1/unMergeIdentities</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="IdentityExists" elementType="Argument">
            <stringProp name="Argument.name">IdentityExists</stringProp>
            <stringProp name="Argument.value">api/v1/identityExists</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="Enrich" elementType="Argument">
            <stringProp name="Argument.name">Enrich</stringProp>
            <stringProp name="Argument.value">api/v1/enrichDemographicsQuery</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
      <hashTree/>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Thread Group">
        <intProp name="ThreadGroup.num_threads">10</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
