{
  "name": "hca-poc",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration dev",
    "start:dev": "ng serve --configuration dev",
    "start:int": "ng serve --configuration int",
    "start:test": "ng serve --configuration test",
    "start:prod": "ng serve --configuration prod",
    "copy:runtime-files": "node scripts/copy-runtime-files.js",
    "build": "ng build --configuration prod && npm run copy:runtime-files && npm run zip:hca-poc",
    "build:dev": "ng build --configuration dev && npm run copy:runtime-files && npm run zip:hca-poc",
    "build:int": "ng build --configuration int && npm run copy:runtime-files && npm run zip:hca-poc",
    "build:test": "ng build --configuration test && npm run copy:runtime-files && npm run zip:hca-poc",
    "build:prod": "ng build --configuration prod && npm run copy:runtime-files && npm run zip:hca-poc",
    "zip:hca-poc": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/zip-hca-poc.ps1",
    "watch": "ng build --watch --configuration dev",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^14.1.1",
    "@angular/cdk": "^14.0.2",
    "@angular/common": "^14.0.0",
    "@angular/compiler": "^14.0.0",
    "@angular/core": "^14.0.0",
    "@angular/forms": "^14.0.0",
    "@angular/material": "^14.0.2",
    "@angular/platform-browser": "^14.0.0",
    "@angular/platform-browser-dynamic": "^14.0.0",
    "@angular/router": "^14.0.0",
    "@popperjs/core": "^2.11.5",
    "bootstrap": "^5.1.3",
    "express": "^4.19.2",
    "hammerjs": "^2.0.8",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "ngx-permissions": "^13.0.1",
    "ngx-spinner": "^13.1.1",
    "ngx-toastr": "^15.0.0",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^14.0.0",
    "@angular/cli": "^14.2.13",
    "@angular/compiler-cli": "^14.0.0",
    "@types/jasmine": "~4.0.0",
    "@types/node": "^16.18.101",
    "jasmine-core": "~4.1.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "typescript": "~4.7.2"
  }
}
